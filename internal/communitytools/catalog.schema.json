{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shreyam1008/ProtoPeek/blob/master/internal/communitytools/catalog.schema.json",
  "title": "ProtoPeek community tool catalog",
  "description": "Reviewed, version-pinned optional executables. Host applications accept IDs only, never caller-provided downloads.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "group", "description", "license", "source", "assets"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64, "not": {"enum": ["aria2", "cloudflared", "yt-dlp", "gallery-dl", "deno", "ffmpeg"]}},
      "name": {"type": "string", "minLength": 1, "maxLength": 100},
      "group": {"enum": ["Inspect traffic & services", "Connect & publish", "Transfer files", "AI & agents", "Containers & clusters"]},
      "description": {"type": "string", "minLength": 1, "maxLength": 500},
      "license": {"type": "string", "minLength": 1, "maxLength": 200},
      "source": {"type": "string", "pattern": "^https://", "maxLength": 2048},
      "assets": {
        "type": "array", "minItems": 1,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["platform", "version", "url", "sha256", "size", "format"],
          "properties": {
            "platform": {"enum": ["windows/amd64", "windows/arm64", "windows/386", "linux/amd64", "linux/arm64", "linux/386", "darwin/amd64", "darwin/arm64"]},
            "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
            "url": {"type": "string", "pattern": "^https://", "maxLength": 2048},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "size": {"type": "integer", "minimum": 1, "maximum": 268435456},
            "format": {"enum": ["binary", "zip", "tar.gz"]},
            "member": {"type": "string", "minLength": 1, "maxLength": 512},
            "binarySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "binarySize": {"type": "integer", "minimum": 1, "maximum": 268435456}
          },
          "allOf": [
            {"if": {"properties": {"format": {"const": "binary"}}}, "then": {"not": {"anyOf": [{"required": ["member"]}, {"required": ["binarySha256"]}, {"required": ["binarySize"]}]}}},
            {"if": {"properties": {"format": {"enum": ["zip", "tar.gz"]}}}, "then": {"required": ["member", "binarySha256", "binarySize"]}}
          ]
        }
      }
    }
  }
}
