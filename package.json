{
  "name": "protopeek",
  "private": true,
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": ">=1.3.10"
  },
  "scripts": {
    "build": "bun run build:app && bun run build:site && bun run check:bundle-budget",
    "build:app": "vite build --config web/vite.console.config.ts",
    "build:site": "vite build --config web/vite.site.config.ts && bun scripts/prerender-site.tsx && bun scripts/generate-site-docs.mjs",
    "check:bundle-budget": "bun scripts/bundle-budget.ts",
    "dev": "vite --config web/vite.console.config.ts",
    "dev:site": "vite --config web/vite.site.config.ts",
    "format": "biome format --write web scripts/bundle-budget.ts package.json biome.json",
    "lint": "biome check web scripts/bundle-budget.ts package.json biome.json",
    "prepare": "husky",
    "test": "bun run typecheck && bun run lint && bun run test:ui",
    "test:ui": "vitest run --config web/vitest.config.ts",
    "typecheck": "tsgo -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260326.1",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
